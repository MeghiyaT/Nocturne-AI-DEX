# Nocturne AI — Frontend Environment Variables
# Copy this file to .env.local and fill in the values for your target network.
# All variables are optional but VITE_NETWORK and VITE_INDEXER_URL will print
# a console.warn in the browser if left unset (they fall back to preprod).

# Target Midnight network.
# Supported values: "preview" | "preprod"
# Missing: falls back to "preprod" with a console.warn.
VITE_NETWORK=preprod

# Deployed datasetRegistry contract address (32-byte hex, no 0x prefix).
# Missing: falls back to latest preprod deployment.
VITE_CONTRACT_ADDRESS=7def714414d5008a6567f0a8cff655b40e3fe0c08260f7fc1dc2ab139612fe45

# Midnight indexer GraphQL endpoint for the chosen network.
# Missing: falls back to the preprod indexer with a console.warn.
VITE_INDEXER_URL=https://indexer.preprod.midnight.network/api/v4/graphql

# Midnight indexer WebSocket endpoint (reserved for future subscription support).
VITE_INDEXER_WS_URL=wss://indexer.preprod.midnight.network/api/v4/graphql/ws

# Midnight Proof Server endpoint (for cloud deployments on Render/Railway/Fly.io).
# Defaults to http://localhost:6300 if unset.
VITE_PROOF_SERVER_URL=https://proof-server-8-1-0.onrender.com

